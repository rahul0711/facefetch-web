[Unit]
Description=Genesis Hub face engine (SCRFD + AdaFace, https on :8002)
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=aiserver
Group=aiserver
WorkingDirectory=/home/aiserver/Desktop/Face_Fetching_website
Environment=PYTHON=/home/aiserver/Desktop/Facenet/Face_Testing_Website_With_InsightFace/.venv/bin/python
ExecStart=/home/aiserver/Desktop/Face_Fetching_website/scripts/run_face_search.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
